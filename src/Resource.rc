    IDSTRING_EXECUTE_BUTTON_LABEL_RECEIVE_MODE_START "受信開始"
    IDSTRING_EXECUTE_BUTTON_LABEL_RECEIVE_MODE_STOP "受信停止"
    IDSTRING_TARGET_LABEL_SEND_MODE "ファイル:"
    IDSTRING_TARGET_LABEL_RECEIVE_MODE "受け取り先:"
    IDSTRING_VERSION_DIALOG_TITLE "SerialFileTransferToolについて"
    IDSTRING_VERSION_DIALOG_TEXT "SerialFileTransferTool バージョン%ls\n\n%ls\n\nGitHub: %ls"
    IDSTRING_SFTT_VERSION SFTT_VERSION
    IDSTRING_SFTT_LICENCE SFTT_LICENCE
    IDSTRING_SFTT_GITHUB SFTT_GITHUB
